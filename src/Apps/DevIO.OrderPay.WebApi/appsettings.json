{
  //"Logging": {
  //  "LogLevel": {
  //    "Default": "Information",
  //    "Microsoft.AspNetCore": "Warning"
  //  }
  //},
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/logs/orderpay-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 2,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "OpenTelemetry": {
    "ServiceName": "DevIO.OrderPay.WebApi",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://seq:5341"
  },
  "Keycloak": {
    "Authority": "http://localhost:8085/realms/orderpay",
    "Audience": "orderpay-webapi",
    "MetadataAddress": "http://keycloak:8085/realms/orderpay/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:8085/realms/orderpay",
    "RequireHttpsMetadata": false
  },
  "AllowedHosts": "*"
}
