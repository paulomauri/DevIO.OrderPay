{
  "realm": "orderpay",
  "enabled": true,
  "displayName": "OrderPay",
  "displayNameHtml": "<strong>OrderPay</strong>",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "defaultRoles": ["customer"],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator — full access"
      },
      {
        "name": "customer",
        "description": "Customer — standard access"
      }
    ]
  },

  "clients": [
    {
      "clientId": "orderpay-webapi",
      "name": "OrderPay WebApi",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "orderpay-swagger",
      "name": "OrderPay Swagger UI",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://api.localhost/*",
        "http://www.localhost/*",
        "http://localhost/*",
        "http://localhost:8080/*",
        "http://localhost:5208/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://api.localhost",
        "http://www.localhost",
        "http://localhost",
        "http://localhost:8080",
        "http://localhost:5208",
        "http://127.0.0.1"
      ],
      "protocolMappers": [
        {
          "name": "orderpay-webapi-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orderpay-webapi",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "admin@orderpay.com",
      "email": "admin@orderpay.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "OrderPay",
      "credentials": [
        {
          "type": "password",
          "value": "Mauri@22",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "customer"]
    },
    {
      "username": "user@orderpay.com",
      "email": "user@orderpay.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "User",
      "lastName": "OrderPay",
      "credentials": [
        {
          "type": "password",
          "value": "User@123",
          "temporary": false
        }
      ],
      "realmRoles": ["customer"]
    }
  ]
}
