# ============================================================
# .env — local overrides (never commit real passwords!)
# Copy this file to .env and fill in your values.
# ============================================================

# ── Backend — Docker Compose ─────────────────────────────────

# SA password — must meet SQL Server complexity requirements:
#   8+ chars, mix of upper, lower, digit, symbol
MSSQL_SA_PASSWORD=your-password-here

# Host port to expose SQL Server on (default 1433)
SQL_HOST_PORT=1433

# Seq
SEQ_ADMIN_PASSWORD=your-password-here

# ── Frontend — Docker Compose (orderpay-web container) ───────
# These are read by docker-compose for the orderpay-web service.
# For local dev outside Docker, copy to orderpay-web/.env.local instead.

NEXTAUTH_SECRET=BRASIL-HEXA-CAMPEAO-DO-MUNDO
KEYCLOAK_CLIENT_ID=orderpay-web
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

