# ============================================================
# .env  —  local overrides (never commit real passwords!)
# Copy this file to .env and fill in your values.
# ============================================================

# SA password — must meet SQL Server complexity requirements:
#   8+ chars, mix of upper, lower, digit, symbol
MSSQL_SA_PASSWORD=mauri#22

# Host port to expose SQL Server on (default 1433)
SQL_HOST_PORT=1433
